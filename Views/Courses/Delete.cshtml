@model Course
@{ ViewData["Title"] = "Delete course"; }
<div class="page-head"><h1>Delete @Model.Code?</h1></div>
<p class="lead">This removes the course and its @Model.Enrollments.Count student enrollment(s). It cannot be undone.</p>
<form asp-action="Delete" method="post" class="form-actions">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger" type="submit">Delete course</button>
    <a class="btn" asp-action="Index">Keep course</a>
</form>
