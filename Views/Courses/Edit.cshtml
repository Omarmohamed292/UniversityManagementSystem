@model Course
@{ ViewData["Title"] = "Edit course"; }
<div class="page-head"><h1>Edit @Model.Code</h1></div>
<form asp-action="Edit" class="stack">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <div class="form-actions"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn" asp-action="Index">Cancel</a></div>
</form>
