@model Student
<div asp-validation-summary="ModelOnly"></div>
<div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" autocomplete="given-name" /><span asp-validation-for="FirstName"></span></div>
<div class="field"><label asp-for="LastName"></label><input asp-for="LastName" autocomplete="family-name" /><span asp-validation-for="LastName"></span></div>
<div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
<div class="field"><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" /><span asp-validation-for="DateOfBirth"></span></div>
<div class="field"><label asp-for="EnrollmentDate"></label><input asp-for="EnrollmentDate" /><span asp-validation-for="EnrollmentDate"></span></div>
