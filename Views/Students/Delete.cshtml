@model Student
@{ ViewData["Title"] = "Delete student"; }
<div class="page-head"><h1>Delete @Model.FullName?</h1></div>
<p class="lead">This removes the student and their @Model.Enrollments.Count course enrollment(s). It cannot be undone.</p>
<form asp-action="Delete" method="post" class="form-actions">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger" type="submit">Delete student</button>
    <a class="btn" asp-action="Index">Keep student</a>
</form>
