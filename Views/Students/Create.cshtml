@model Student
@{ ViewData["Title"] = "Add student"; }
<div class="page-head"><h1>Add student</h1></div>
<form asp-action="Create" class="stack">
    <partial name="_Form" model="Model" />
    <div class="form-actions"><button class="btn btn-primary" type="submit">Add student</button><a class="btn" asp-action="Index">Cancel</a></div>
</form>
